{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyDeck shared terminology collection",
  "description": "Each written entry stores one term and definition for BOTH directions. Do not include separate reverse quizzes, prompt, or exampleAnswer.",
  "type": "array",
  "items": {
    "$ref": "#/definitions/test"
  },
  "definitions": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "const": "terminology"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "kind": {
          "enum": [
            "chapter",
            "midterm"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "tone": {
          "enum": [
            "sage",
            "sky",
            "amber",
            "lilac",
            "coral"
          ]
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/term"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "title",
        "chapters",
        "kind",
        "minutes",
        "tone",
        "questions",
        "category"
      ]
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "const": "written"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "acceptedTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "id",
        "type",
        "term",
        "definition"
      ]
    }
  }
}
